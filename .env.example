# RESQ Environment Configuration Example

# Backend Secret Key for JWT Signatures
SECRET_KEY=resq_enterprise_operations_secure_secret_key_2026

# Database: PostgreSQL for Production, SQLite for Local Zero-Config Dev
DATABASE_URL=sqlite+aiosqlite:///./resq.db
# DATABASE_URL=postgresql+asyncpg://resq_user:resq_secure_password_2026@localhost:5432/resq_db

# Google Gemini API Key (Optional: when omitted, platform uses authoritative deterministic engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Default Region
DEFAULT_CITY=Suryanagar, India
CITY_LAT=16.5062
CITY_LNG=80.6480

# Production Ports & CORS (Optional)
PORT=8000
FRONTEND_PORT=3000
POSTGRES_USER=resq_user
POSTGRES_PASSWORD=resq_secure_password_2026
POSTGRES_DB=resq_db
