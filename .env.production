# ==============================================================================
# RESQ PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Copy this file to .env on your production server or inject into cloud env vars.
# ==============================================================================

# Core Application Security
# Generate a 64-char key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=resq_super_secure_production_secret_key_2026_xyz987

# PostgreSQL Database (asyncpg driver required for async operations)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://resq_user:resq_secure_password_2026@postgres:5432/resq_db

# Google Gemini API (Provide your key here or via deployment dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Operational Region Defaults
DEFAULT_CITY=Suryanagar, India
CITY_LAT=16.5062
CITY_LNG=80.6480

# Production Ports & Services
PORT=8000
FRONTEND_PORT=3000
POSTGRES_USER=resq_user
POSTGRES_PASSWORD=resq_secure_password_2026
POSTGRES_DB=resq_db

# Optional Cross-Origin Frontend API Override (leave empty if behind reverse proxy/Nginx)
VITE_API_URL=
VITE_WS_URL=
